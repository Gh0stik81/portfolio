---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  provider: 'youtube' | 'vimeo';
  id: string;
  title: string;
  playLabel: string;
  cover?: ImageMetadata;
}

const { provider, id, title, playLabel, cover } = Astro.props;

const src =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
    : `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`;

const remoteThumb = provider === 'youtube' ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined;
---

<div class="video-embed" data-video-embed data-src={src} data-title={title}>
  <button type="button" class="facade" aria-label={`${playLabel}: ${title}`}>
    {
      cover ? (
        <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 40rem) 100vw, 50vw" />
      ) : remoteThumb ? (
        <img src={remoteThumb} alt="" loading="lazy" decoding="async" width="480" height="360" />
      ) : null
    }
    <span class="play" aria-hidden="true"></span>
  </button>
</div>

<script>
  // Iframe sa načíta až po kliknutí, aby stránka nesťahovala prehrávač vopred.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.video-embed .facade');
    if (!button) return;
    const wrapper = button.parentElement as HTMLElement;
    const iframe = document.createElement('iframe');
    iframe.src = wrapper.dataset.src ?? '';
    iframe.title = wrapper.dataset.title ?? '';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    wrapper.replaceChildren(iframe);
  });
</script>

<style>
  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-2);
  }

  .facade {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .facade:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 3.5rem;
    height: 3.5rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    transition: background var(--transition);
  }

  .play::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 54%;
    translate: -50% -50%;
    border-style: solid;
    border-width: 0.6rem 0 0.6rem 1rem;
    border-color: transparent transparent transparent var(--color-text);
  }

  .facade:hover .play {
    background: var(--color-accent);
  }

  .video-embed :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
