---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../i18n/utils';

interface Props {
  work: CollectionEntry<'works'>;
  lang: Lang;
  start: number;
  span: number;
}

const { work, lang, start, span } = Astro.props;
const { type, title, year } = work.data;
---

<a
  class="clip"
  href={`#work-${work.id}`}
  data-clip
  data-type={type}
  style={`--start: ${start}; --span: ${span};`}
>
  <span class="clip-title">{title[lang]}</span>
  <span class="clip-meta">{year}</span>
</a>

<style>
  .clip {
    grid-column: var(--start) / span var(--span);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--type-color) 70%, black);
    background: color-mix(in srgb, var(--type-color) 35%, var(--color-surface));
    text-decoration: none;
    transition: background var(--transition), transform var(--transition);
  }

  .clip:hover {
    background: color-mix(in srgb, var(--type-color) 55%, var(--color-surface));
  }

  .clip-title {
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .clip-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 40rem) {
    .clip {
      grid-column: auto;
    }
  }
</style>
