---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath, useTranslations } from '../i18n/utils';

const sk = useTranslations('sk');
const en = useTranslations('en');
---

<BaseLayout lang="sk" title={`404 | ${sk('meta.title')}`} description={sk('404.title')} noAlternates>
  <main class="not-found container">
    <p class="code">404</p>
    <h1>{sk('404.title')}</h1>
    <p lang="en" class="en">{en('404.title')}</p>
    <p class="links">
      <a href={localizedPath('sk')}>{sk('404.back')}</a>
      <a href={localizedPath('en')} lang="en">{en('404.back')}</a>
    </p>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
  }

  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    color: var(--color-accent);
  }

  .en {
    margin: 0;
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .links a {
    color: var(--color-accent);
  }
</style>
